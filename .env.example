PENTEST_DASHBOARD_HOST=127.0.0.1
PENTEST_DASHBOARD_PORT=8765
PENTEST_DASHBOARD_DATABASE_URL=sqlite:///./data/database/dashboard.db
PENTEST_DASHBOARD_DATA_DIR=./data
PENTEST_DASHBOARD_LOG_LEVEL=INFO
PENTEST_DASHBOARD_WATCHER_ENABLED=true
PENTEST_DASHBOARD_BACKUP_RETENTION=30
PENTEST_DASHBOARD_MAX_UPLOAD_SIZE=104857600
PENTEST_DASHBOARD_AUTH_MODE=local
PENTEST_DASHBOARD_SECRET_KEY=change-this-in-production
PENTEST_DASHBOARD_ACCESS_TOKEN_EXPIRE_MINUTES=30
PENTEST_DASHBOARD_REFRESH_TOKEN_EXPIRE_DAYS=7
PENTEST_DASHBOARD_BOOTSTRAP_ADMIN_USERNAME=admin
PENTEST_DASHBOARD_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
PENTEST_DASHBOARD_AUTH_COOKIE_SECURE=false
PENTEST_DASHBOARD_ACCESS_COOKIE_NAME=ptd_access_token
PENTEST_DASHBOARD_REFRESH_COOKIE_NAME=ptd_refresh_token
PENTEST_DASHBOARD_OPEN_BROWSER=true
